    "productName": "Musician",
    "compression": "normal",
    "directories": {
      "output": "release"
    },
    "extraResources": [
      {
        "from": "browser-mcp",
        "to": "browser-mcp",
        "filter": [
          "server.js"
        ]
      },
      {
        "from": "build/icon.ico",
        "to": "icon.ico"
      }
    ],
    "files": [
      "dist/**/*",
      "electron/**/*",
      "browser-mcp/**/*",
      "scripts/windows-toast.js",
      "package.json",
      "node_modules/@muse-code/sdk/**/*"
    ],
    "win": {
      "target": [
        "portable"
      ],
      "icon": "build/icon.ico"
    },
    "portable": {
      "artifactName": "Musician.exe"
    }
  },
